{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-usage-iq",
  "version": "0.1.0",
  "identifier": "admin.actn.usage-iq",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "usage-iq"
        ]
      }
    }
  },
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-usage-iq",
        "width": 800,
        "height": 600,
        "devtools": true,
        "visible": true,
        "hiddenTitle": false,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Usage IQ"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}